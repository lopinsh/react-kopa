# Copy to .env and adjust. Values below match `docker compose up -d db soketi`.

# Database (docker-compose maps Postgres to host port 5433)
DATABASE_URL="postgresql://kopa_user:kopa_password@localhost:5433/ejam_kopa?schema=public"

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="change-me"
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth providers
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_ID=""
GOOGLE_SECRET=""

# Realtime (local Soketi, Pusher protocol)
PUSHER_APP_ID="app-id"
PUSHER_SECRET="app-secret"
NEXT_PUBLIC_PUSHER_KEY="app-key"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"
NEXT_PUBLIC_PUSHER_HOST="localhost"
NEXT_PUBLIC_PUSHER_PORT="6001"
NEXT_PUBLIC_PUSHER_TLS="false"
# Optional server-side overrides (production: soketi / 6001 / false over the Docker network).
# When unset, the server uses the NEXT_PUBLIC_* values above.
# PUSHER_KEY="app-key"
# PUSHER_HOST="localhost"
# PUSHER_PORT="6001"
# PUSHER_TLS="false"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feedback mode: agents read admin notes via /api/feedback with this bearer token (32+ random chars).
# Leave empty to disable the API (it then answers 404). `npm run feedback` reads both values.
FEEDBACK_API_TOKEN=""
# FEEDBACK_API_URL="https://ejam.lumm.eu"

# Unsplash (banner search; optional, curated photos work without it)
UNSPLASH_ACCESS_KEY=

# Email digest (R33). Without SMTP_URL emails are only logged. Example: smtps://user:pass@smtp.example.com:465
SMTP_URL=""
MAIL_FROM="Ejam Kopā <noreply@ejam.lumm.eu>"
# Shared secret for the home-server cron that POSTs /api/cron/email-digest (32+ random chars). Empty: the route answers 404.
CRON_SECRET=""

# Matrix (K4): Synapse starts with `npm run db:up` (renders .matrix/ from these values). Unset MATRIX_AS_TOKEN = Synapse skipped, the site runs the same.
# Dev values; the server (K4-2) gets its own secrets.
MATRIX_SERVER_NAME="ejam.local"
MATRIX_HOMESERVER_URL="http://localhost:8008"
MATRIX_PUBLIC_URL="http://localhost:8008"
MATRIX_AS_TOKEN="dev-as-token-ejam-0123456789abcdef0123456789abcdef"
MATRIX_HS_TOKEN="dev-hs-token-ejam-0123456789abcdef0123456789abcdef"
MATRIX_DB_PASSWORD="dev-synapse-db-password"
MATRIX_MACAROON_SECRET="dev-macaroon-secret-0123456789abcdef"
MATRIX_FORM_SECRET="dev-form-secret-0123456789abcdef"
MATRIX_DB_HOST="db"
# Dev only: guest peeking for the signed-out reading test (F4). Leave false on the server.
MATRIX_ALLOW_GUESTS="true"
