# Front proxy owned by the stack (docker-compose.server.yml, service "proxy").
# The host's reverse proxy keeps pointing at :3000; Caddy forwards to the 3 app
# processes of the colour (blue/green) that deploy/server-deploy.sh just made live,
# so a deploy swaps containers without a 502. The script fills __UPSTREAMS__ and
# reloads Caddy gracefully (in-flight requests finish on the old colour).
{
	auto_https off
	admin localhost:2019
	servers {
		# The host proxy terminates TLS; keep its X-Forwarded-* headers.
		trusted_proxies static private_ranges
	}
}

:3000 {
	reverse_proxy __UPSTREAMS__ {
		# Sticky per browser: unstable_cache / revalidatePath are per process, so a
		# visitor keeps seeing their own writes. Technical cookie (an upstream hash).
		# Clients without it (or pointing at a down upstream) get least_conn.
		lb_policy cookie ejk_lb {
			fallback least_conn
		}
		# An upstream that fails to dial is retried on another one.
		lb_try_duration 15s
		lb_try_interval 250ms
		fail_duration 5s
		health_uri /api/health
		health_interval 2s
		health_timeout 2s
		flush_interval -1
	}
}
